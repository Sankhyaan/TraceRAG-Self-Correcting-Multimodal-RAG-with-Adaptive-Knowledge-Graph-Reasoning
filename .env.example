# ==========================================
# TRACE RAG — Environment Configuration
# Copy this file to .env and fill in values
# ==========================================

# LLM Provider Configuration ("gemini" or "anthropic")
LLM_PROVIDER=gemini

# Google Gemini API
# Get this from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.0-flash

# Anthropic Claude API (Optional / Alternative)
# Get this from https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-api03-...
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Supabase Settings
# Get these from your Supabase Dashboard: Project Settings → API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_STORAGE_BUCKET=trace-files

# Supabase JWT Secret — for verifying user tokens on the backend
# Get from: Supabase Dashboard → Project Settings → API → JWT Secret
# Leave empty in local dev to skip JWT verification (routes stay open)
SUPABASE_JWT_SECRET=

# Qdrant Vector Database
# For local Qdrant: http://localhost:6333 (API key can be empty)
# For Qdrant Cloud: https://xyz-example.eu-central.aws.cloud.qdrant.io:6333
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# Application & File Upload Limits
MAX_UPLOAD_SIZE_MB=50
MAX_FILES_PER_CONVERSATION=20
ALLOWED_EXTENSIONS=pdf,doc,docx,txt,md,png,jpg,jpeg,webp,mp3,wav,m4a,ogg,mp4,mov,mkv,webm

# CORS — set to your Vercel/Netlify frontend URL in production
# Example: FRONTEND_URL=https://trace-rag.vercel.app
FRONTEND_URL=http://localhost:3000

# Local System Tool Overrides (Optional — uncomment if not in system PATH)
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
# FFMPEG_CMD=ffmpeg
